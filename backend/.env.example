APP_NAME=PaperTrail API
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://papertrail:papertrail@localhost:5432/papertrail

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (chat/answer generation) ---
# Defaults to Groq's free tier — get a key at https://console.groq.com/keys.
# Any OpenAI-compatible provider works by changing these three values.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Get this from your Clerk dashboard -> API Keys -> Secret key
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Optional - improves CrossRef API rate limits ("polite pool")
CROSSREF_CONTACT_EMAIL=

# --- Embeddings & vector search ---
# Runs locally via onnxruntime — no API key. Vectors are stored in
# Postgres via pgvector, so there is no separate vector database to run.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# How embedding jobs run:
#   celery           - dedicated worker process + Redis (`make worker`)
#   background_tasks - in-process after the response; no worker, no broker.
#                      Use this on free-tier hosting that can't keep a worker alive.
EMBEDDING_BACKEND=celery

# --- Background jobs (Celery) --- only needed when EMBEDDING_BACKEND=celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- File storage ---
# local    - writes to LOCAL_STORAGE_ROOT on disk. Fine for development.
# supabase - a private Supabase Storage bucket. Required on hosts whose disk
#            doesn't survive restarts (Render's free tier wipes it, which was
#            silently losing every uploaded PDF).
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=50

# Only needed when STORAGE_BACKEND=supabase. Create the bucket as PRIVATE in
# the Supabase dashboard first — the app never creates it, and never hands out
# public or signed URLs: reads are proxied through GET /papers/{id}/file so the
# ownership check in PaperService still runs before any bytes are served.
# Use the SERVICE ROLE key, not the anon key: this is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=papers
